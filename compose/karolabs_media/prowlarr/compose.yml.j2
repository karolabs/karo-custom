{{ ansible_managed | comment }}

---

name: prowlarr
services:

  prowlarr:
    image: {{ stack_vars.prowlarr.image }}
    container_name: prowlarr
    restart: {{ karo_compose_restart_policy }}
    init: false # s6 must be pid 1

    ## security
    user: 1000:1000
    tty: false
    stdin_open: false
    read_only: true
    tmpfs:
      - /tmp:mode=1777,noexec,nosuid,nodev
      - /run:mode=0755,exec,nosuid,nodev,uid=1000,gid=1000 # s6 needs ownership & exec
    security_opt:
      - no-new-privileges:true
    cap_drop:
      - ALL

    ## config
    network_mode: "container:gluetun"
    volumes:
      - type: volume
        source: prowlarr_data
        target: /config
    labels:
      - traefik.enable=true
      - traefik.http.routers.prowlarr.rule=Host(`{{ stack_vars.prowlarr.domain }}`)
      - traefik.http.services.prowlarr.loadbalancer.server.port=9696
{% if stack_vars.prowlarr.forward_auth_enabled %}
      ## forward auth
      - traefik.http.routers.prowlarr.middlewares=tinyauth
      - tinyauth.apps.prowlarr.config.domain={{ stack_vars.prowlarr.domain }}
      - tinyauth.apps.prowlarr.oauth.groups={{ karo_compose_oidc_admin_group }}
{% endif %}
    environment:
      - TZ={{ karo_compose_timezone }}
      - S6_READ_ONLY_ROOT=1 # inform s6 of read-only root filesystem

volumes:
  prowlarr_data:
    name: prowlarr_data
