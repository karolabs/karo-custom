{{ ansible_managed | comment }}

---

name: radarr
services:

  radarr:
    image: {{ stack_vars.radarr.image }}
    container_name: radarr
    restart: {{ karo_compose_restart_policy }}
    init: false # s6 must be pid 1

    ## security
    user: 1000:1000
    security_opt: ["no-new-privileges:true"]
    cap_drop: ["ALL"]
    # cap_add: []
    read_only: true
    tmpfs:
      - /tmp:mode=1777,noexec,nosuid,nodev
      - /run:mode=0755,exec,nosuid,nodev,uid=1000,gid=1000 # s6 needs ownership & exec

    ## config
    network_mode: "container:gluetun"
    volumes:
      - type: bind
        source: {{ stack_vars.radarr.data_path }}
        target: /data
      - type: volume
        source: radarr_data
        target: /config
    labels:
      - traefik.enable=true
      - traefik.http.routers.radarr.rule=Host(`{{ stack_vars.radarr.domain }}`)
      - traefik.http.services.radarr.loadbalancer.server.port=7878
{% if stack_vars.radarr.forward_auth_enabled %}
      ## forward auth
      - traefik.http.routers.radarr.middlewares=tinyauth
      - tinyauth.apps.radarr.config.domain={{ stack_vars.radarr.domain }}
      - tinyauth.apps.radarr.oauth.groups={{ karo_compose_oidc_admin_group }}
{% endif %}
    environment:
      - TZ={{ karo_compose_timezone }}
      - S6_READ_ONLY_ROOT=1 # inform s6 of read-only root filesystem

volumes:
  radarr_data:
    name: radarr_data
