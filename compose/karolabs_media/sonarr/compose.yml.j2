{{ ansible_managed | comment }}

---

name: sonarr
services:

  sonarr:
    image: {{ stack_vars.sonarr.image }}
    container_name: sonarr
    restart: {{ karo_compose_restart_policy }}
    init: false # s6 must be pid 1

    ## security
    user: 1000:1000
    tty: false
    stdin_open: false
    read_only: true
    tmpfs:
      - /tmp:mode=1777,noexec,nosuid,nodev
      - /run:mode=0755,exec,nosuid,nodev,uid=1000,gid=1000 # s6 needs ownership & exec
    security_opt:
      - no-new-privileges:true
    cap_drop:
      - ALL

    ## config
    network_mode: "container:gluetun"
    volumes:
      - type: bind
        source: {{ stack_vars.sonarr.data_path }}
        target: /data
      - type: volume
        source: sonarr_data
        target: /config
    labels:
      - traefik.enable=true
      - traefik.http.routers.sonarr.rule=Host(`{{ stack_vars.sonarr.domain }}`)
      - traefik.http.services.sonarr.loadbalancer.server.port=8989
{% if stack_vars.sonarr.forward_auth_enabled %}
      # forward auth
      - traefik.http.routers.sonarr.middlewares=tinyauth
      - tinyauth.apps.sonarr.config.domain={{ stack_vars.sonarr.domain }}
      - tinyauth.apps.sonarr.oauth.groups={{ karo_compose_oidc_admin_group }}
{% endif %}
    environment:
      - TZ={{ karo_compose_timezone }}
      - S6_READ_ONLY_ROOT=1 # inform s6 of read-only root filesystem

volumes:
  sonarr_data:
    name: sonarr_data
