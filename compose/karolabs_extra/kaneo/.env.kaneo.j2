# karo-custom stack template, for rendering files used by Docker Compose.
# See https://docs.karolabs.dev for more information.

{{ ansible_managed | comment }}

---

## kaneo
LOG_LEVEL:          "{{ stack_vars.kaneo.log_level }}"
KANEO_CLIENT_URL:   "https://{{ stack_vars.kaneo.domain }}"
AUTH_SECRET_FILE:   "/run/secrets/kaneo_auth_secret"
TRUSTED_PROXIES:    "172.18.0.254"

NOTIFICATION_SECRET_ENCRYPTION_KEY_FILE: "/run/secrets/kaneo_notification_secret"

## oidc
CUSTOM_OAUTH_CLIENT_ID:           "{{ stack_vars.kaneo.oidc_client_id }}"
CUSTOM_OAUTH_CLIENT_SECRET_FILE:  "/run/secrets/kaneo_oidc_client_secret"
CUSTOM_OAUTH_DISCOVERY_URL:       "{{ karo_compose_oidc_url }}/.well-known/openid-configuration"
CUSTOM_OAUTH_SCOPE:               "openid,profile,email"
CUSTOM_OAUTH_NAME:                "{{ karo_compose_oidc_provider_name }}"
DISABLE_PASSWORD_REGISTRATION:    "true"
CUSTOM_OAUTH_AUTO_LOGIN:          "true"
