## postgres
TZ:                         "{{ karo_compose_timezone }}"
POSTGRES_DB:                "kaneo"
POSTGRES_USER:              "pgadmin"
POSTGRES_PASSWORD_FILE:     "/run/secrets/postgres_password"
POSTGRES_INITDB_ARGS:       "--data-checksums --auth=scram-sha-256"
