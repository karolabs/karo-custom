{{ ansible_managed | comment }}

---

name: proxy
services:

  haproxy:
    image: {{ stack_vars.haproxy.image }}
    container_name: haproxy
    restart: {{ karo_compose_restart_policy }}
    init: true

    ## security
    # user: 65532:65532 by default
    read_only: true
    tmpfs:
      - /tmp:mode=1777,noexec,nosuid,nodev
    security_opt:
      - no-new-privileges:true
    cap_drop:
      - ALL

    ## config
    command: ["-f", "/usr/local/etc/haproxy/haproxy.cfg"]
    ports:
      - "0.0.0.0:80:8080/tcp"
      - "0.0.0.0:443:8443/tcp"
    networks:
      - egress_haproxy
    volumes:
      - type: bind
        source: /srv/docker/karolabs_ops/proxy/haproxy.cfg
        target: /usr/local/etc/haproxy/haproxy.cfg
        read_only: true

networks:
  egress_haproxy:
    name: egress_haproxy
    driver: bridge
    internal: false
